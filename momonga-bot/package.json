{
  "name": "momonga-bot",
  "version": "0.1.0",
  "private": true,
  "description": "모몽가 - 개인 서버 전용 노래 봇",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js --env=prod",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:prod": "tsx src/deploy-commands.ts --env=prod",
    "typecheck": "tsc --noEmit",
    "voice-report": "tsx src/voice-report.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
